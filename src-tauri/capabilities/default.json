{
  "identifier": "default",
  "description": "Default capabilities for Opencode Desktop",
  "windows": ["main"],
  "remote": {
    "urls": ["http://*:*"]
  },
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-minimize",
    "core:window:allow-is-maximized",
    "core:window:allow-close",
    "core:window:allow-toggle-maximize"
  ]
}
